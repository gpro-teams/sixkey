{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sixkey:rules:1:baseline",
  "title": "A Sixkey rules bundle built into a release, schema 1 (rules/baseline.json)",
  "description": "Site rules, and the alias groups and \"code after the password\" hosts imported from upstream files whose hashes are pinned. Sixkey's checker (extension/src/core/rules/format.ts) also checks what this schema cannot: hosts as in site-rule.schema.json, each host pointing at a rule of this bundle and every rule pointed at, the licence matching the upstream list, and aliases or appends only with an upstream file named.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "schema",
    "version",
    "created",
    "license",
    "source",
    "upstream",
    "rules",
    "hosts",
    "aliases",
    "appends"
  ],
  "properties": {
    "format": {
      "const": "sixkey-rules"
    },
    "schema": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "A counter: each release's baseline and each published bundle takes the next one."
    },
    "created": {
      "$ref": "#/$defs/date"
    },
    "source": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^$|^https://[A-Za-z0-9.-]+\\.[A-Za-z0-9-]+(?::[0-9]{1,5})?(?:[/?#][\\x21-\\x7e]*)?$",
      "description": "Where the source of this bundle is: an https address of the repository at this version, in its forge's form, or empty in a build that names no repository. A store package refuses an empty one."
    },
    "rules": {
      "type": "object",
      "maxProperties": 5000,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/rule"
      },
      "description": "The rules by id."
    },
    "hosts": {
      "type": "object",
      "maxProperties": 20000,
      "propertyNames": {
        "$ref": "#/$defs/host"
      },
      "additionalProperties": {
        "$ref": "#/$defs/id"
      },
      "description": "Each exact host, and the id of its rule. Every rule has at least one host and at most 16."
    },
    "kind": {
      "const": "baseline"
    },
    "license": {
      "enum": ["AGPL-3.0-or-later", "AGPL-3.0-or-later AND MIT"],
      "description": "AGPL-3.0-or-later, and MIT when upstream data is in it."
    },
    "upstream": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/upstream"
      }
    },
    "aliases": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/shared"
          },
          {
            "$ref": "#/$defs/oneWay"
          }
        ]
      }
    },
    "appends": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/host"
      },
      "description": "Hosts where the code is typed after the password, in the password box."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?\\.)+[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?$",
      "description": "A host name as a URL parser writes it (lower case, punycode, no trailing dot or port), of two labels or more. Sixkey's checker also refuses IP addresses, shared suffixes (co.uk, github.io, ...) and, in a store build's bundle, the reserved names .test, .example, .invalid and .localhost."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A calendar date, YYYY-MM-DD."
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "field", "segments", "fill"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^/[!$-)+-;=@-\\[\\]_a-z|~]*$",
          "description": "A literal prefix of location.pathname as the browser gives it (percent-encoded, case-sensitive): printable ASCII without what a browser always percent-encodes in a path (space, \" # < > ? \\ ^ ` { }) and without *, which is no wildcard here."
        },
        "field": {
          "$ref": "#/$defs/selector"
        },
        "segments": {
          "type": "integer",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 4,
              "maximum": 8
            }
          ],
          "description": "0: one box; 4 to 8: exactly that many boxes, in document order, form the code's group."
        },
        "fill": {
          "enum": ["auto", "chars", "paste"],
          "description": "The group's strategy; one box takes \"auto\" only."
        }
      },
      "if": {
        "properties": {
          "segments": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "fill": {
            "const": "auto"
          }
        }
      }
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:[a-z][a-z0-9-]*(?:#-?[A-Za-z_][A-Za-z0-9_-]*|\\.-?[A-Za-z_][A-Za-z0-9_-]*|\\[[a-z][a-z0-9_-]*(?:\\^?=\"[ !#-\\[\\]-~]*\"|~=\"[!#-\\[\\]-~]+\")?\\])*|(?:#-?[A-Za-z_][A-Za-z0-9_-]*|\\.-?[A-Za-z_][A-Za-z0-9_-]*|\\[[a-z][a-z0-9_-]*(?:\\^?=\"[ !#-\\[\\]-~]*\"|~=\"[!#-\\[\\]-~]+\")?\\])+)(?:(?: > | )(?:[a-z][a-z0-9-]*(?:#-?[A-Za-z_][A-Za-z0-9_-]*|\\.-?[A-Za-z_][A-Za-z0-9_-]*|\\[[a-z][a-z0-9_-]*(?:\\^?=\"[ !#-\\[\\]-~]*\"|~=\"[!#-\\[\\]-~]+\")?\\])*|(?:#-?[A-Za-z_][A-Za-z0-9_-]*|\\.-?[A-Za-z_][A-Za-z0-9_-]*|\\[[a-z][a-z0-9_-]*(?:\\^?=\"[ !#-\\[\\]-~]*\"|~=\"[!#-\\[\\]-~]+\")?\\])+)){0,7}$",
      "description": "Compound selectors joined by exactly one space (descendant) or \" > \" (child). A compound: an optional type, then any of #id, .class, [name], [name=\"value\"], [name^=\"value\"], [name~=\"word\"]. Ids and classes are CSS identifiers without escapes (an optional -, then a letter or _, then letters, digits, _ and -); a value is printable ASCII without '\"' or '\\\\', a word the same without spaces and not empty. No pseudo-classes, :has(), lists, *, ~ or + combinators. At most one #id per compound (Sixkey's checker)."
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages"],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/page"
          }
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["sent"]
          }
        },
        "minLeft": {
          "type": "integer",
          "minimum": 5,
          "maximum": 20,
          "description": "Seconds of the code's period that must remain to fill it on this site (default 5, never more than half the period)."
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "commit", "path", "sha256", "license"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z0-9-]+$"
        },
        "url": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^https://[a-z0-9.-]+(?:/[A-Za-z0-9_.~-]+)*$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license": {
          "enum": ["MIT"]
        }
      }
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s"],
      "properties": {
        "s": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/host"
          }
        }
      },
      "description": "Every host is the same sign-in."
    },
    "oneWay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["f", "t"],
      "properties": {
        "f": {
          "type": "array",
          "minItems": 1,
          "maxItems": 63,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/host"
          }
        },
        "t": {
          "type": "array",
          "minItems": 1,
          "maxItems": 63,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/host"
          }
        }
      },
      "description": "Accounts of the f hosts are offered on the t hosts, never the other way. At most 64 hosts in all, none twice (Sixkey's checker)."
    }
  }
}
