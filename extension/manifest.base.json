{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "version": "0.1.5",
  "default_locale": "en",
  "minimum_chrome_version": "140",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Sixkey",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      }
    },
    "lock": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdLock__"
    },
    "fill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "__MSG_cmdFill__"
    }
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "optional_host_permissions": ["https://*/*"],
  "permissions": ["storage", "unlimitedStorage", "activeTab", "alarms", "idle", "offscreen", "sidePanel"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; default-src 'self'; connect-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'"
  },
  "optional_permissions": ["clipboardRead", "clipboardWrite", "scripting", "nativeMessaging"]
}
