{
  "name": "sixkey-extension",
  "version": "0.1.3",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:test": "node scripts/build.mjs --test && node scripts/check-dist.mjs --test",
    "check": "node scripts/check-dist.mjs",
    "format": "prettier --write --ignore-path ../.gitignore --ignore-path ../.prettierignore ..",
    "format:check": "prettier --check --ignore-path ../.gitignore --ignore-path ../.prettierignore ..",
    "notices": "node scripts/notices.mjs --write",
    "notices:check": "node scripts/notices.mjs --check",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && npm run build:e2e && node scripts/check-dist.mjs --e2e && npm run build:dev && node scripts/check-dist.mjs --dev && playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run check && npm run e2e",
    "build:e2e": "node scripts/build.mjs --e2e"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "preact": "10.29.8",
    "qr": "0.7.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
