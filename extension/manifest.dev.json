{
  "name": "Sixkey (dev)",
  "key": "",
  "optional_host_permissions": ["http://127.0.0.1:8787/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; default-src 'self'; connect-src http://127.0.0.1:8787; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'"
  },
  "optional_permissions": ["clipboardRead", "clipboardWrite", "scripting"]
}
